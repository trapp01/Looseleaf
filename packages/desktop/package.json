{
  "name": "@looseleaf/desktop",
  "productName": "Looseleaf",
  "version": "0.1.0",
  "description": "Looseleaf desktop app: an Electron shell around the web client.",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=dist --out-extension:.js=.cjs",
    "dev": "pnpm run build && electron .",
    "smoke": "pnpm run build && tsx scripts/smoke.ts",
    "package": "pnpm run build && npx --yes electron-builder@26.18.0 --config electron-builder.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "ws": "^8.23.0"
  }
}
